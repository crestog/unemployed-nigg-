.nyc_output

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Python bytecode from the scripts/ data builders. Two .pyc files were tracked,
# which is worse than untracked: they were stale bytecode of an older revision of
# the very scripts beside them.
__pycache__/
*.pyc

