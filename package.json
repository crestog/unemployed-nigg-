    "data:split": "node scripts/split-roadmap-data.mjs",
    "build": "pnpm data:derive && vite build",
    "preview": "vite preview --host",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:download": "python3 scripts/download_real_data.py",
    "data:build": "python3 scripts/build_real_data.py",
    "data:refresh": "pnpm data:download && pnpm data:build",
    "data:world:build": "node scripts/build_world_venture_data.mjs && node scripts/build_india_tiles.mjs",
    "data:world:global:build": "python3 scripts/build_global_geoboundaries_mvt.py",
    "data:india:tiles": "node scripts/build_india_tiles.mjs",
