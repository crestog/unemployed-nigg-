# Cache-Control for the static assets, applied by the asset layer itself.
#
# This has to live here rather than in `worker.ts`. With Workers Static Assets,
# a request that matches a real file is answered by the asset layer and never
# reaches the Worker, so a `withAssetCacheHeaders()` helper on the Worker's
# fetch path only ever saw requests that missed — and the asset layer's own
# default, `public, max-age=0, must-revalidate`, was what production actually
# served for every JS bundle, stylesheet and data release. Measured live: the
# entry chunk, `taxonomies.json` and `occupations-index.json` all revalidated
# on every load.
#
# Wrangler uploads this file as asset metadata and excludes it from the served
# asset manifest, so it is configuration, not a public file.
#
# Every rule that matches contributes its value, and same-named values are
# joined with a comma rather than overriding — a broad `/data/*` alongside a
# narrower `/data/world-mvt/manifest.json` produced
# `max-age=86400, …, max-age=31536000, immutable, max-age=300, must-revalidate`
# on one response. So the rules below are deliberately disjoint: no path matches
# two of them. `:release` matches exactly one segment, which is what keeps a
# release directory from also matching the bare manifest beside it.

# Vite fingerprints everything under /assets, so the name changes whenever the
# bytes do. Nothing here can go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Vendored MapLibre glyph ranges. Not fingerprinted, so a month rather than a
# year: re-vendoring the fonts has to be able to take effect.
/fonts/*
  Cache-Control: public, max-age=2592000

# Tile shards and their part indexes are release-scoped: the release id is in
# the path, so a new release is a new URL and nothing has to be invalidated.
/data/world-mvt/:release/*
  Cache-Control: public, max-age=31536000, immutable

/data/india-tiles/:release/*
  Cache-Control: public, max-age=31536000, immutable

# The bare manifests are the exception. They name the current release, so they
# are the one thing that must stay fresh; everything they point at is addressed
# by release id and covered by the two rules above.
/data/manifest.json
  Cache-Control: public, max-age=300, must-revalidate

/data/world-mvt/manifest.json
  Cache-Control: public, max-age=300, must-revalidate

/data/india-tiles/manifest.json
  Cache-Control: public, max-age=300, must-revalidate

# The committed and derived data releases. A day, with a week of
# stale-while-revalidate, so a refresh lands without making the visit that
# discovers it wait. Listed one by one rather than as `/data/*`, which would
# also match the release directories and the manifests above.
/data/roadmaps/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/taxonomies.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/occupations-index.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/occupations-detail.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/occupations.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/roadmap-content.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/roadmap-graphs.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/international.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/world-venture.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/world-india-geography.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The startup-ecosystem layer. The detail file is the largest single JSON here
# at 6.3 MB and is fetched lazily, on the first record a visitor opens, so
# leaving it on the asset layer's must-revalidate default would re-download it
# every session for the one interaction it serves.
/data/atlas-entities-india.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/atlas-entities-india-detail.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The service worker decides what the browser keeps. Caching it would pin a
# deploy's caching policy in place for as long as the header lasted.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800
